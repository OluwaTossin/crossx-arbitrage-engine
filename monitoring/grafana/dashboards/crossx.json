{
  "uid": "crossx-phase1",
  "title": "CrossX Phase 1 \u2014 Research only",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Research service ready",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "crossx_ready",
          "legendFormat": "{{exchange}} {{symbol}} {{buy}} {{sell}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Feed synchronized",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "crossx_book_synchronized",
          "legendFormat": "{{exchange}} {{symbol}} {{buy}} {{sell}}"
