# Research only. Unknown fees disable opportunities; insert your verified tier assumptions.
CROSSX_DATABASE_URL=postgresql+asyncpg://crossx:crossx@localhost:5432/crossx
CROSSX_FEES={"kraken":{"maker":null,"taker":null},"coinbase":{"maker":null,"taker":null}}
# Illustrative assumptions ONLY, not a current exchange fee schedule:
# CROSSX_FEES={"kraken":{"taker":"0.004"},"coinbase":{"taker":"0.006"}}

# Bound storage stalls and orderly shutdown (seconds; positive finite values).
CROSSX_PERSISTENCE_TIMEOUT_SECONDS=10
CROSSX_SHUTDOWN_TIMEOUT_SECONDS=5

# Immediate adaptive transactions; queue capacity stays 128.
CROSSX_PERSISTENCE_BATCH_SIZE=32
# Default retains every observation. Optional routine-history sampling only.
CROSSX_BOOK_SAMPLE_INTERVAL_SECONDS=0
# Storage warning budgets, not quotas or automatic deletion.
CROSSX_STORAGE_BUDGET_GIB=30
CROSSX_DAILY_BOOK_BUDGET_GIB=20
# Optional read-only retention eligibility plan (no expiry runs automatically).
# CROSSX_RETENTION_DAYS=7
